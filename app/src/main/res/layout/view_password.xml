<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/password"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="@dimen/section_spacing_medium"
        >

    <TextView
        android:id="@+id/textView_password_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/password_text"
        android:textSize="@dimen/form_label_text_size"
        />

    <LinearLayout
        android:layout_width="@dimen/form_field_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/editTextPasswordInput"
            android:layout_width="0dp"
            android:layout_height="@dimen/form_field_height"
            android:layout_weight="1"
            android:autofillHints="password"
            android:ems="10"
            android:hint="@string/password_text"
            android:inputType="textPassword" />

        <ImageView
            android:id="@+id/iv_password_toggle"
            android:layout_width="@dimen/password_toggle_size"
            android:layout_height="@dimen/password_toggle_size"
            android:padding="8dp"
            android:contentDescription="@string/password_text"
            android:src="@drawable/baseline_visibility_24" />
    </LinearLayout>

</LinearLayout>