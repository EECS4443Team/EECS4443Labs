<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/username"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="@dimen/section_spacing_large"
    >

    <TextView
        android:id="@+id/textView_username_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/username_text"
        android:textSize="@dimen/form_label_text_size" />

    <EditText
        android:id="@+id/editTextUsernameInput"
        android:layout_width="@dimen/form_field_width"
        android:layout_height="@dimen/form_field_height"
        android:layout_gravity="center"
        android:autofillHints="username"
        android:ems="10"
        android:hint="@string/username_text"
        android:inputType="text"
        tools:ignore="DuplicateSpeakableTextCheck,TextContrastCheck" />


</LinearLayout>